{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/net-availability-monitor/config.schema.json",
  "title": "net-availability-monitor configuration",
  "description": "Единый файл настроек для macOS-менюбара, Windows-трея, Python-сервера и Android-приложения.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "server",
    "polling",
    "incidents",
    "history",
    "status_labels",
    "status_colors",
    "services",
    "notifications"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_sec",
        "check_timeout_sec",
        "dns_timeout_sec"
      ],
      "properties": {
        "interval_sec": {
          "type": "integer",
          "minimum": 5
        },
        "check_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "dns_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_after_failures",
        "close_after_successes",
        "max_stored"
      ],
      "properties": {
        "open_after_failures": {
          "type": "integer",
          "minimum": 1
        },
        "close_after_successes": {
          "type": "integer",
          "minimum": 1
        },
        "max_stored": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_age_hours",
        "max_points",
        "series_points"
      ],
      "properties": {
        "max_age_hours": {
          "type": "integer",
          "minimum": 1
        },
        "max_points": {
          "type": "integer",
          "minimum": 1
        },
        "series_points": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "degraded",
        "blocked",
        "down",
        "unknown"
      ],
      "properties": {
        "ok": {
          "type": "string"
        },
        "degraded": {
          "type": "string"
        },
        "blocked": {
          "type": "string"
        },
        "down": {
          "type": "string"
        },
        "unknown": {
          "type": "string"
        }
      }
    },
    "status_colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "degraded",
        "blocked",
        "down",
        "unknown"
      ],
      "properties": {
        "ok": {
          "$ref": "#/definitions/color"
        },
        "degraded": {
          "$ref": "#/definitions/color"
        },
        "blocked": {
          "$ref": "#/definitions/color"
        },
        "down": {
          "$ref": "#/definitions/color"
        },
        "unknown": {
          "$ref": "#/definitions/color"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subtitle",
          "icon",
          "accent",
          "incident_title",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "accent": {
            "$ref": "#/definitions/color"
          },
          "incident_title": {
            "type": "string"
          },
          "hints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/check"
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "macos_menubar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "overlay",
                "dot",
                "text"
              ]
            },
            "overlay_window_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overlay_dot_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status_item_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "windows_tray": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "tray"
              ]
            },
            "dot_pt": {
              "type": "integer",
              "minimum": 8,
              "maximum": 64
            }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "windows": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "notify_on": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded",
                  "blocked",
                  "down",
                  "unknown"
                ]
              }
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "notify_on": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded",
                  "blocked",
                  "down",
                  "unknown"
                ]
              }
            },
            "foreground_service": {
              "type": "boolean"
            },
            "sound": {
              "type": "boolean"
            },
            "vibrate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slow_latency_ms": {
          "type": "number",
          "minimum": 100,
          "description": "Порог «медленно» для статуса degraded (по умолчанию 4000 мс); Python-сервер (и Windows, который его запускает) читает параметр, Android пока использует фиксированные 4000 мс.",
          "maximum": 600000
        }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "host",
        "port",
        "core",
        "timeout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "dns",
            "tcp",
            "tls",
            "https"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string"
        },
        "expect": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "core": {
          "type": "boolean"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "https"
          }
        }
      },
      "then": {
        "required": [
          "path",
          "expect"
        ]
      }
    }
  }
}
